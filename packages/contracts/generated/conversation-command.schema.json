  "discriminator": {
    "mapping": {
      "conversation.cancel": "#/$defs/ConversationRunCommand",
      "conversation.create": "#/$defs/ConversationCreateCommand",
      "conversation.events": "#/$defs/ConversationEventsCommand",
      "conversation.history": "#/$defs/ConversationHistoryCommand",
      "conversation.list": "#/$defs/ConversationListCommand",

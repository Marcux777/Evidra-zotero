      "conversation.start": "#/$defs/ConversationRunCommand",
      "conversation.vectors.build": "#/$defs/VectorBuildCommand",
      "conversation.vectors.cancel": "#/$defs/VectorJobCommand",
      "conversation.vectors.read": "#/$defs/VectorJobCommand"
    },
    "propertyName": "op"

{
  "$defs": {
    "ConversationCreate": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key"
      ],
      "title": "ConversationCreate",
      "type": "object"
    },
    "ConversationCreateCommand": {
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Notebook Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^(?:[a-f0-9]{32}|[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "op": {
          "const": "conversation.create",
          "title": "Op",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ConversationCreate"
        }
      },
      "required": [
        "notebook_id",
        "snapshot_id",
        "op",
        "request"
      ],
      "title": "ConversationCreateCommand",
      "type": "object"
    },

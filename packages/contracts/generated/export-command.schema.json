{
  "$defs": {
    "ContentRemap": {
      "additionalProperties": false,
      "properties": {
        "original_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Original Key",
          "type": "string"
        },
        "target_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pdf",
            "abstract",
            "human_note",
            "human_annotation",
            "ai_artifact",
            "approved_data",
            "text_attachment"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "original_key",
        "target_key",
        "kind"
      ],
      "title": "ContentRemap",
      "type": "object"
    },
    "ExportCreate": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "preview_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Preview Id",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "preview_id"
      ],
      "title": "ExportCreate",
      "type": "object"
    },
    "ExportCreateCommand": {
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Notebook Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^(?:[a-f0-9]{32}|[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "op": {
          "const": "exports.create",
          "title": "Op",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ExportCreate"
        }
      },
      "required": [
        "notebook_id",
        "snapshot_id",
        "op",
        "request"
      ],
      "title": "ExportCreateCommand",
      "type": "object"
    },
    "ExportOptions": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "json",
            "markdown",
            "csv_studies",
            "csv_results",
            "backup",
            "bibtex",
            "ris",
            "csl_json"
          ],
          "title": "Format",
          "type": "string"
        },
        "excel": {
          "default": false,
          "title": "Excel",
          "type": "boolean"
        },
        "include_pdfs": {
          "default": false,
          "title": "Include Pdfs",
          "type": "boolean"
        },
        "source_ids": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "format"
      ],
      "title": "ExportOptions",
      "type": "object"
    },

          "type": "string"
        },
        "preview_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Preview Id",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "preview_id"
      ],
      "title": "BulkApprove",
      "type": "object"
    },
    "BulkItem": {

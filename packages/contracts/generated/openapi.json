  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "protocol_version": {
            "type": "integer",
            "title": "Protocol Version",
            "default": 1
          }
        },
        "type": "object",
        "title": "HealthStatus"
      },
      "Notebook": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "profile_instance_id": {
            "type": "string",
            "title": "Profile Instance Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "initial_snapshot_id": {
            "type": "string",
            "title": "Initial Snapshot Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "profile_instance_id",
          "name",
          "created_at",
          "updated_at",
          "revision",
          "initial_snapshot_id"
        ],
        "title": "Notebook"
      },
      "NotebookCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "idempotency_key"
        ],
        "title": "NotebookCreate"
      },
      "NotebookPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Notebook"
            },
            "type": "array",
            "title": "Items"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "offset",
          "limit",
          "total"
        ],
        "title": "NotebookPage"
      },
      "RuntimeStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "protocol_version": {
            "type": "integer",
            "title": "Protocol Version",
            "default": 1
          },
          "profile_instance_id": {
            "type": "string",
            "title": "Profile Instance Id"
          },
          "heartbeat_interval_seconds": {
            "type": "integer",
            "title": "Heartbeat Interval Seconds",
            "default": 10
          },
          "heartbeat_timeout_seconds": {
            "type": "integer",
            "title": "Heartbeat Timeout Seconds",
            "default": 30
          }
        },
        "type": "object",
        "required": [
          "profile_instance_id"
        ],
        "title": "RuntimeStatus"
      },
      "EngineManifest": {
        "additionalProperties": false,
        "properties": {
          "manifest_version": {
            "const": 1,
            "title": "Manifest Version",
            "type": "integer"
          },
          "protocol_version": {
            "const": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "engine_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "title": "Engine Version",
            "type": "string"
          },
          "platform": {
            "const": "win32",
            "title": "Platform",
            "type": "string"
          },
          "architecture": {
            "const": "x86_64",
            "title": "Architecture",
            "type": "string"
          },
          "entrypoint": {
            "const": "evidra-engine.exe",
            "title": "Entrypoint",
            "type": "string"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/PayloadFile"
            },
            "maxItems": 10000,
            "minItems": 1,
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "manifest_version",
          "protocol_version",
          "engine_version",
          "platform",
          "architecture",
          "entrypoint",
          "files"
        ],
        "title": "EngineManifest",
        "type": "object"
      },
      "PayloadFile": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 240,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_./ -]+$",
            "title": "Path",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "title": "Size",
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "title": "PayloadFile",
        "type": "object"
      }
    }
  }

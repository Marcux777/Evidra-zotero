{
  "$defs": {
    "ArtifactReadCommand": {
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Notebook Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^(?:[a-f0-9]{32}|[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "op": {
          "const": "research.artifact",
          "title": "Op",
          "type": "string"
        },
        "version_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "notebook_id",
        "snapshot_id",
        "op",
        "version_id"
      ],
      "title": "ArtifactReadCommand",
      "type": "object"
    },
    "ArtifactReview": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "action": {
          "enum": [
            "APPROVED",
            "CORRECTED",
            "REJECTED"
          ],
          "title": "Action",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        },
        "corrected_output": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "AUDIT": "#/$defs/AuditOutput",
                  "SCREENING": "#/$defs/ScreeningOutput",
                  "SYNTHESIS": "#/$defs/SynthesisOutput"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ScreeningOutput"
                },
                {
                  "$ref": "#/$defs/SynthesisOutput"
                },
                {
                  "$ref": "#/$defs/AuditOutput"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Output"
        }
      },
      "required": [
        "idempotency_key",
        "expected_revision",
        "action",
        "rationale"
      ],
      "title": "ArtifactReview",
      "type": "object"
    },
    "ArtifactReviewCommand": {
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Notebook Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^(?:[a-f0-9]{32}|[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "op": {
          "const": "research.review",
          "title": "Op",
          "type": "string"
        },
        "version_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Version Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ArtifactReview"
        }
      },
      "required": [
        "notebook_id",
        "snapshot_id",
        "op",
        "version_id",
        "request"
      ],
      "title": "ArtifactReviewCommand",
      "type": "object"
    },
    "ArtifactVersionsCommand": {
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Notebook Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^(?:[a-f0-9]{32}|[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})$",

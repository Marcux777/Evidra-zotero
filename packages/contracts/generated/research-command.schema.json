          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "notebook_id",
        "snapshot_id",
        "op",
        "version_id",
        "offset"
      ],
      "title": "ArtifactVersionsCommand",
      "type": "object"
    },
    "AuditClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "start": {
          "maximum": 12000,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 12000,
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "support": {
          "enum": [
            "SUPPORTED_PROPOSAL",
            "PARTIALLY_SUPPORTED_PROPOSAL",
            "CONTRADICTED_PROPOSAL",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Support",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/AuditReference"
          },
          "maxItems": 12,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "support",
        "evidence_ids",
        "explanation",
        "references"
      ],
      "title": "AuditClaim",
      "type": "object"
    },
    "AuditOutput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "AUDIT",
          "title": "Kind",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/AuditClaim"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "collection_limitations": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Collection Limitations",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "claims",
        "collection_limitations"
      ],
      "title": "AuditOutput",
      "type": "object"
    },
    "AuditReference": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Citation",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "relationship": {
          "enum": [
            "DIRECT",
            "INDIRECT_MENTION",
            "NOT_IN_NOTEBOOK"
          ],
          "title": "Relationship",
          "type": "string"
        }
      },
      "required": [
        "citation",
        "source_id",
        "relationship"
      ],
      "title": "AuditReference",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
